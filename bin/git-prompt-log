#!/usr/bin/env python3
# Generated by Antigravity CLI 1.1.25 (Gemini 3.8 Flash (High))
"""
Git Prompt Log
Records AI session metadata and steering prompts directly onto git notes,
and provides deterministic prompt merging across git rebase, squash, and amend.
"""

import abc
import argparse
import datetime
import json
import os
import re
import subprocess
import sys
import tempfile
from collections import defaultdict
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple, Union


DEFAULT_NOTES_REF = "refs/notes/commits"


@dataclass
class PromptEntry:
    timestamp: str  # Format: "YYYY-MM-DD HH:MM:SS UTC" or "YYYY-MM-DD HH:MM:SS"
    text: str

    def format(self) -> str:
        lines = self.text.splitlines()
        if not lines:
            return f"  [{self.timestamp}]"
        first_line = lines[0].strip()
        out = [f"  [{self.timestamp}] {first_line}"]
        for line in lines[1:]:
            out.append(f"    {line}")
        return "\n".join(out)


@dataclass
class SessionNote:
    session_id: str
    harness: str
    model: str
    recorded_at: str
    prompts: List[PromptEntry] = field(default_factory=list)

    def format(self) -> str:
        out = [
            f"Assistant-Session: {self.session_id}",
            f"Assistant-Harness: {self.harness}",
            f"Assistant-Model: {self.model}",
            f"Assistant-Recorded: {self.recorded_at}",
            "",
            "Assistant-Prompts:",
        ]
        if self.prompts:
            for p in self.prompts:
                out.append(p.format())
        else:
            out.append("  (No steering prompts recorded)")
        return "\n".join(out)


def parse_timestamp_sort_key(ts: str) -> str:
    """Extracts a normalized ISO-sortable string from timestamp."""
    cleaned = ts.replace(" UTC", "").strip()
    return cleaned


def parse_note_block(block: str) -> Optional[SessionNote]:
    """Parses a single session block from a git note."""
    lines = block.strip().splitlines()
    if not lines:
        return None

    session_id = ""
    harness = ""
    model = ""
    recorded_at = ""
    prompts: List[PromptEntry] = []

    in_prompts = False
    current_ts: Optional[str] = None
    current_lines: List[str] = []

    prompt_header_re = re.compile(r"^\s*\[(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}(?:\s*UTC)?)\](?:\s*(.*))?$")

    def flush_prompt():
        nonlocal current_ts, current_lines
        if current_ts is not None:
            text = "\n".join(current_lines).strip()
            prompts.append(PromptEntry(timestamp=current_ts, text=text))
            current_ts = None
            current_lines = []

    for line in lines:
        if not in_prompts:
            if line.startswith("Assistant-Session:"):
                session_id = line.split(":", 1)[1].strip()
            elif line.startswith("Assistant-Harness:"):
                harness = line.split(":", 1)[1].strip()
            elif line.startswith("Assistant-Model:"):
                model = line.split(":", 1)[1].strip()
            elif line.startswith("Assistant-Recorded:"):
                recorded_at = line.split(":", 1)[1].strip()
            elif line.strip() == "Assistant-Prompts:":
                in_prompts = True
        else:
            if line.startswith("Assistant-Session:"):
                # Hit next session header
                break
            m = prompt_header_re.match(line)
            if m:
                flush_prompt()
                current_ts = m.group(1).strip()
                inline_text = m.group(2) or ""
                current_lines = [inline_text] if inline_text.strip() else []
            elif current_ts is not None:
                # Continuation line
                stripped = line.strip()
                if stripped:
                    current_lines.append(stripped)

    flush_prompt()

    if not session_id and not prompts:
        return None

    return SessionNote(
        session_id=session_id or "unknown",
        harness=harness or "unknown",
        model=model or "unknown",
        recorded_at=recorded_at or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
        prompts=prompts,
    )


def extract_prompt_block(raw_note: str) -> Tuple[str, str, str]:
    """
    Identifies the prompt note block purely by its self-describing grammar:
      Assistant-Session: <id>
      Assistant-Harness: <harness>
      Assistant-Model: <model>
      Assistant-Recorded: <ts>
      Assistant-Prompts:
        [timestamp] prompt...
    Returns (prefix, prompt_block, suffix), preserving surrounding non-prompt notes.
    """
    if not raw_note or not raw_note.strip():
        return "", "", ""

    lines = raw_note.splitlines()
    start_idx = None
    end_idx = None

    i = 0
    while i < len(lines):
        line = lines[i]
        # Detect start of session record
        if start_idx is None and line.strip().startswith("Assistant-Session:"):
            start_idx = i
            end_idx = i + 1
            i += 1
            continue

        if start_idx is not None:
            stripped = line.strip()
            # Check if line conforms to prompt note structure:
            # - Empty lines within the note
            # - '---' separating multi-session blocks
            # - Standard headers: 'Assistant-Session:', 'Assistant-Harness:', etc.
            # - Indented prompt entries: starts with 2+ spaces or tabs
            is_prompt_structure = (
                not stripped
                or stripped == "---"
                or bool(re.match(r"^Assistant-(Session|Harness|Model|Recorded|Prompts):", stripped))
                or line.startswith("  ")
                or line.startswith("\t")
            )
            if is_prompt_structure:
                end_idx = i + 1
            else:
                # Reached non-prompt external content
                break
        i += 1

    if start_idx is None:
        return raw_note.strip(), "", ""

    prefix = "\n".join(lines[:start_idx]).strip()
    prompt_block = "\n".join(lines[start_idx:end_idx]).strip()
    suffix = "\n".join(lines[end_idx:]).strip() if end_idx is not None else ""

    return prefix, prompt_block, suffix


def wrap_prompt_block(prompt_notes_text: str, prefix: str = "", suffix: str = "") -> str:
    """Stitches prompt note text with surrounding external content cleanly without banners."""
    parts = []
    if prefix.strip():
        parts.append(prefix.strip())
        parts.append("")

    parts.append(prompt_notes_text.strip())

    if suffix.strip():
        parts.append("")
        parts.append(suffix.strip())

    return "\n".join(parts) + "\n"


def parse_notes(raw_text: str) -> List[SessionNote]:
    """Parses raw git note content, extracting the prompt block if present."""
    if not raw_text or not raw_text.strip():
        return []

    _, prompt_block, _ = extract_prompt_block(raw_text)
    if not prompt_block:
        return []

    # Split by session separator lines or blank line before next session
    blocks = re.split(r"\n+(?:---\s*\n+)?(?=Assistant-Session:\s*)", prompt_block.strip())
    results = []
    for b in blocks:
        parsed = parse_note_block(b)
        if parsed:
            results.append(parsed)
    return results


def serialize_notes(notes: List[SessionNote]) -> str:
    """Serializes a list of SessionNote objects into standard git note text."""
    if not notes:
        return ""
    return "\n\n---\n\n".join(n.format() for n in notes) + "\n"


def merge_session_notes(notes: List[SessionNote]) -> List[SessionNote]:
    """
    Merges session notes across commits (e.g. during a squash or fixup).
    - If multiple notes share the same session_id:
      Prompts are unioned, deduplicated chronologically, and the latest recorded date is kept.
    - If notes have distinct session_ids:
      Each session is preserved as a distinct block, sorted chronologically.
    """
    if not notes:
        return []

    grouped: Dict[str, List[SessionNote]] = defaultdict(list)
    for n in notes:
        grouped[n.session_id].append(n)

    merged_sessions: List[SessionNote] = []

    for sid, group in grouped.items():
        # Sort group by recorded_at
        group.sort(key=lambda x: parse_timestamp_sort_key(x.recorded_at))
        latest = group[-1]

        # Union and deduplicate prompts
        seen_prompts: Set[Tuple[str, str]] = set()
        combined_prompts: List[PromptEntry] = []

        for g in group:
            for p in g.prompts:
                key = (parse_timestamp_sort_key(p.timestamp), p.text.strip())
                if key not in seen_prompts:
                    seen_prompts.add(key)
                    combined_prompts.append(p)

        # Sort combined prompts reverse-chronologically (newest first so causal prompt is at the top)
        combined_prompts.sort(key=lambda p: parse_timestamp_sort_key(p.timestamp), reverse=True)

        merged_sessions.append(
            SessionNote(
                session_id=sid,
                harness=latest.harness,
                model=latest.model,
                recorded_at=latest.recorded_at,
                prompts=combined_prompts,
            )
        )

    # Sort merged sessions chronologically by their earliest prompt or recorded_at
    def session_sort_key(s: SessionNote) -> str:
        if s.prompts:
            return parse_timestamp_sort_key(s.prompts[0].timestamp)
        return parse_timestamp_sort_key(s.recorded_at)

    merged_sessions.sort(key=session_sort_key)
    return merged_sessions


# --- Git Plumbing Utilities ---


def run_git(args: List[str], repo_root: Optional[Path] = None, input_text: Optional[str] = None) -> Tuple[int, str, str]:
    """Runs a git command and returns (code, stdout, stderr)."""
    cwd = str(repo_root) if repo_root else None
    res = subprocess.run(
        ["git"] + args,
        cwd=cwd,
        input=input_text,
        text=True,
        capture_output=True,
    )
    return res.returncode, res.stdout.strip(), res.stderr.strip()


def get_repo_root() -> Path:
    """Returns the working tree root directory."""
    code, out, _ = run_git(["rev-parse", "--show-toplevel"])
    if code == 0 and out:
        return Path(out).resolve()
    return Path.cwd().resolve()


def get_common_git_dir(repo_root: Optional[Path] = None) -> Path:
    """Returns the shared .git directory (resolving worktrees)."""
    code, out, _ = run_git(["rev-parse", "--git-common-dir"], repo_root=repo_root)
    if code == 0 and out:
        p = Path(out)
        if not p.is_absolute() and repo_root:
            p = (repo_root / p).resolve()
        return p
    code, out, _ = run_git(["rev-parse", "--git-dir"], repo_root=repo_root)
    if code == 0 and out:
        p = Path(out)
        if not p.is_absolute() and repo_root:
            p = (repo_root / p).resolve()
        return p
    return (repo_root or Path.cwd()) / ".git"


def get_note_content(commit_hash: str, ref: str = DEFAULT_NOTES_REF, repo_root: Optional[Path] = None) -> Optional[str]:
    """Retrieves existing git note content for a commit, or None if no note exists."""
    code, out, _ = run_git(["notes", f"--ref={ref}", "show", commit_hash], repo_root=repo_root)
    if code == 0 and out:
        return out
    return None


def write_note_content(commit_hash: str, note_text: str, ref: str = DEFAULT_NOTES_REF, repo_root: Optional[Path] = None) -> bool:
    """Attaches or overwrites a git note on a commit."""
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False) as tf:
        tf.write(note_text)
        temp_path = tf.name

    try:
        code, _, err = run_git(["notes", f"--ref={ref}", "add", "-f", "-F", temp_path, commit_hash], repo_root=repo_root)
        if code != 0:
            sys.stderr.write(f"git notes add failed for {commit_hash}: {err}\n")
            return False
        return True
    finally:
        if os.path.exists(temp_path):
            os.remove(temp_path)


def remove_note_content(commit_hash: str, ref: str = DEFAULT_NOTES_REF, repo_root: Optional[Path] = None) -> bool:
    """Removes a git note on a commit."""
    code, _, _ = run_git(["notes", f"--ref={ref}", "remove", commit_hash], repo_root=repo_root)
    return code == 0


def get_configured_exclude_patterns(repo_root: Optional[Path] = None) -> List[str]:
    """Retrieves all prompt-log.exclude (and legacy prompt-note.exclude) regex patterns from git config."""
    patterns: List[str] = []
    for key in ("prompt-log.exclude", "prompt-note.exclude"):
        code, out, _ = run_git(["config", "--get-all", key], repo_root=repo_root)
        if code == 0 and out:
            for line in out.splitlines():
                line = line.strip()
                if line and line not in patterns:
                    patterns.append(line)
    return patterns


def _safe_search(pattern: str, text: str) -> bool:
    """Safely executes regex search against text, handling inline flags and invalid patterns."""
    if not pattern:
        return False
    try:
        # Strip inline flags (e.g. (?i)) if misplaced because re.IGNORECASE is already supplied
        norm_pattern = re.sub(r"\(\?[aiLmsux]+\)", "", pattern)
        return bool(re.search(norm_pattern, text, re.IGNORECASE))
    except re.error:
        try:
            return bool(re.search(pattern, text, re.IGNORECASE))
        except re.error:
            return False


# --- Transcript and Agent Discovery ---


def get_brain_dir() -> Path:
    """Locates the Antigravity / Gemini CLI brain directory."""
    candidates = [
        os.environ.get("ANTIGRAVITY_DATA_DIR", ""),
        os.environ.get("GEMINI_CLI_HOME", ""),
        os.path.expanduser("~/.gemini/antigravity-cli"),
        os.path.expanduser("~/.config/antigravity-cli"),
    ]
    for candidate in candidates:
        if candidate:
            b_path = Path(candidate) / "brain"
            if b_path.exists() and b_path.is_dir():
                return b_path
            if Path(candidate).name == "brain" and Path(candidate).is_dir():
                return Path(candidate)

    return Path(os.path.expanduser("~/.gemini/antigravity-cli/brain"))


def get_session_excludes_file(session_id: str, repo_root: Optional[Path] = None) -> Path:
    """Returns path to the session-specific exclusions JSON file."""
    brain = get_brain_dir()
    session_dir = brain / session_id
    if session_dir.exists():
        return session_dir / "prompt-log-excludes.json"
    common_git = get_common_git_dir(repo_root)
    fallback_dir = common_git / "prompt-log" / "sessions"
    fallback_dir.mkdir(parents=True, exist_ok=True)
    return fallback_dir / f"{session_id}.json"


def load_session_excludes(session_id: str, repo_root: Optional[Path] = None) -> Dict[str, Any]:
    """Loads session exclusions: {'patterns': [...], 'indices': [...], 'timestamps': [...]}."""
    fpath = get_session_excludes_file(session_id, repo_root=repo_root)
    if not fpath.exists():
        brain = get_brain_dir()
        legacy_path = brain / session_id / ".prompt-log-excludes.json"
        if legacy_path.exists():
            fpath = legacy_path
    if fpath.exists():
        try:
            return json.loads(fpath.read_text(encoding="utf-8"))
        except Exception:
            pass
    return {"patterns": [], "indices": [], "timestamps": []}


def save_session_excludes(session_id: str, data: Dict[str, Any], repo_root: Optional[Path] = None) -> None:
    """Saves session exclusions."""
    fpath = get_session_excludes_file(session_id, repo_root=repo_root)
    fpath.parent.mkdir(parents=True, exist_ok=True)
    fpath.write_text(json.dumps(data, indent=2), encoding="utf-8")
    brain = get_brain_dir()
    legacy_path = brain / session_id / ".prompt-log-excludes.json"
    if legacy_path.exists() and legacy_path != fpath:
        try:
            legacy_path.unlink()
        except Exception:
            pass


IGNORE_PREFIX_RE = re.compile(
    r"^(?:\[\s*(?:ignore|skip|skip-note|no-note|no-prompt|scratch|wrong-session|wrong session|wrong-window|wrong window|oops|nolog)\s*[:\]]|"
    r"\(\s*(?:ignore|skip|skip-note|no-note|no-prompt|scratch|wrong-session|wrong session|wrong-window|wrong window|oops|nolog)\s*[:\)]|"
    r"/\s*(?:ignore|skip|wrong-session|wrong-window|no-note)\b|"
    r"//\s*ignore|"
    r"#\s*ignore|"
    r"<!--\s*ignore\s*-->)",
    re.IGNORECASE,
)

IGNORE_LAST_RE = re.compile(
    r"^(?:\[\s*(?:ignore|drop|scratch|retract)-(?:last|prev)(?:\s+(\d+))?\s*\]|"
    r"\[\s*retract(?:\s+(\d+))?\s*\]|"
    r"/\s*(?:ignore|drop)-(?:last|prev)(?:\s+(\d+))?\b)"
    r"(?:\s*(.*))?$",
    re.IGNORECASE | re.DOTALL,
)

IGNORE_ALL_RE = re.compile(
    r"^(?:\[\s*(?:ignore|drop)-(?:all|session)\s*\]|"
    r"/\s*(?:ignore|drop)-(?:all|session)\b)"
    r"(?:\s*(.*))?$",
    re.IGNORECASE | re.DOTALL,
)

STANDALONE_RETRACT_RE = re.compile(
    r"^\[\s*(?:wrong-session|wrong session|wrong-window|wrong window|oops|cancel|retract)\s*\]$",
    re.IGNORECASE,
)

IGNORE_TARGET_RE = re.compile(
    r"^(?:\[\s*(?:retract|drop|ignore|scratch)(?:-prompt|-matching)?\s+(?:\"([^\"]+)\"|\x27([^\x27]+)\x27|/([^/]+)/|#(\d+))\s*\]|"
    r"\[\s*(?:retract-prompt|drop-prompt|ignore-prompt)\s+(\d+)\s*\]|"
    r"/\s*(?:retract|drop|ignore)(?:-prompt|-matching)?\s+(?:\"([^\"]+)\"|\x27([^\x27]+)\x27|/([^/]+)/|#?(\d+))\b|"
    r"/\s*(?:retract|drop|ignore)(?:-prompt|-matching)?\s+(?:\"([^\"]+)\"|\x27([^\x27]+)\x27|/([^/]+)/))"
    r"(?:\s*(.*))?$",
    re.IGNORECASE | re.DOTALL,
)


def is_ignored_prompt(text: str, custom_patterns: Optional[List[str]] = None) -> bool:
    """Returns True if the prompt begins with an ignore/wrong-session marker or matches custom exclusion patterns."""
    clean = text.strip()
    if bool(IGNORE_PREFIX_RE.match(clean)):
        return True
    if custom_patterns:
        for pat in custom_patterns:
            if _safe_search(pat, clean):
                return True
    return False


def clean_user_prompt(content: str) -> str:
    """Strips protocol XML envelopes from user prompts."""
    if not content:
        return ""
    req_match = re.search(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", content, re.DOTALL)
    if req_match:
        text = req_match.group(1)
    else:
        text = re.split(r"<ADDITIONAL_METADATA>", content, flags=re.DOTALL)[0]
        text = re.split(r"<USER_SETTINGS_CHANGE>", text, flags=re.DOTALL)[0]
    return text.strip()


def format_utc(dt_str: str) -> str:
    """Converts ISO timestamp string to UTC string (YYYY-MM-DD HH:MM:SS UTC)."""
    if not dt_str:
        return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    try:
        dt = datetime.datetime.fromisoformat(dt_str.replace("Z", "+00:00")).astimezone(datetime.timezone.utc)
        return dt.strftime("%Y-%m-%d %H:%M:%S UTC")
    except Exception:
        return dt_str


def process_prompt_turns(
    raw_turns: List[Tuple[str, str]],
    custom_patterns: Optional[List[str]] = None,
) -> List[PromptEntry]:
    """Processes sequential prompt turns, applying in-chat retraction, resets, and exclusions."""
    prompts: List[PromptEntry] = []

    for ts, clean in raw_turns:
        if not clean:
            continue

        # 1. Whole-session reset: [ignore-all]
        m_all = IGNORE_ALL_RE.match(clean)
        if m_all:
            prompts.clear()
            remaining = m_all.group(1).strip() if m_all.group(1) else ""
            if remaining and not is_ignored_prompt(remaining, custom_patterns=custom_patterns):
                prompts.append(PromptEntry(timestamp=ts, text=remaining))
            continue

        # 2. Targeted prompt retraction: [retract "Commit"], [drop-prompt 2], [retract #2]
        m_target = IGNORE_TARGET_RE.match(clean)
        if m_target:
            t_str = (
                m_target.group(1)
                or m_target.group(2)
                or m_target.group(3)
                or m_target.group(6)
                or m_target.group(7)
                or m_target.group(8)
                or m_target.group(10)
                or m_target.group(11)
                or m_target.group(12)
            )
            t_idx = m_target.group(4) or m_target.group(5) or m_target.group(9)
            if t_idx:
                idx = int(t_idx) - 1
                if 0 <= idx < len(prompts):
                    prompts.pop(idx)
            elif t_str:
                prompts = [p for p in prompts if not _safe_search(t_str, p.text)]
            remaining = m_target.group(13).strip() if m_target.group(13) else ""
            if remaining and not is_ignored_prompt(remaining, custom_patterns=custom_patterns):
                prompts.append(PromptEntry(timestamp=ts, text=remaining))
            continue

        # 3. Retract previous N prompts: [ignore-last], [ignore-prev 2], [retract]
        m_last = IGNORE_LAST_RE.match(clean)
        if m_last:
            n_str = m_last.group(1) or m_last.group(2) or m_last.group(3)
            n = int(n_str) if n_str else 1
            for _ in range(min(n, len(prompts))):
                prompts.pop()
            remaining = m_last.group(4).strip() if m_last.group(4) else ""
            if remaining and not is_ignored_prompt(remaining, custom_patterns=custom_patterns):
                prompts.append(PromptEntry(timestamp=ts, text=remaining))
            continue

        # 4. Standalone oops/wrong-session marker retracting previous prompt: [wrong-session]
        if STANDALONE_RETRACT_RE.match(clean):
            if prompts:
                prompts.pop()
            continue

        # 5. Prompt explicitly marked to ignore or matching custom exclusion pattern:
        if is_ignored_prompt(clean, custom_patterns=custom_patterns):
            continue

        prompts.append(PromptEntry(timestamp=ts, text=clean))

    return prompts


def apply_session_excludes_filter(
    session_id: str,
    prompts: List[PromptEntry],
    repo_root: Optional[Path] = None,
    custom_patterns: Optional[List[str]] = None,
) -> List[PromptEntry]:
    """Filters prompts according to session-specific exclusions and patterns."""
    session_excludes = load_session_excludes(session_id, repo_root=repo_root)
    if not session_excludes:
        return prompts
    pat_list = list(custom_patterns or []) + list(session_excludes.get("patterns", []))
    ts_list = set(session_excludes.get("timestamps", []))
    idx_set = set(session_excludes.get("indices", []))

    filtered: List[PromptEntry] = []
    for i, p in enumerate(prompts, start=1):
        if i in idx_set:
            continue
        if p.timestamp in ts_list:
            continue
        if any(_safe_search(pat, p.text) for pat in pat_list):
            continue
        filtered.append(p)
    return filtered


class BaseIngestionAdapter(abc.ABC):
    """Abstract base class for AI coding assistant transcript ingestion adapters."""

    name: str = "base"
    display_name: str = "Base Adapter"

    @abc.abstractmethod
    def is_active(self, repo_root: Optional[Path] = None) -> bool:
        """Returns True if this harness is currently running in the active process or environment."""
        pass

    @abc.abstractmethod
    def detect_session_id(self, repo_root: Optional[Path] = None) -> Optional[str]:
        """Returns the active session identifier if detected."""
        pass

    @abc.abstractmethod
    def get_agent_identity(self, detected_model: Optional[str] = None) -> Tuple[str, str]:
        """Returns (harness_name_version, model_name)."""
        pass

    @abc.abstractmethod
    def find_session_data(
        self,
        session_id: Optional[str] = None,
        repo_root: Optional[Path] = None,
        max_age_seconds: Optional[int] = None,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        extra_options: Optional[Dict[str, Any]] = None,
    ) -> Optional[Dict[str, Any]]:
        """
        Extracts session turns returning:
        {
            "session_id": str,
            "detected_model": Optional[str],
            "harness": Optional[str],
            "prompts": List[PromptEntry],
        }
        or None if no session found.
        """
        pass


class AntigravityAdapter(BaseIngestionAdapter):
    name = "antigravity"
    display_name = "Antigravity CLI"

    def is_active(self, repo_root: Optional[Path] = None) -> bool:
        return bool(os.environ.get("AGY_SESSION_ID") or os.environ.get("ANTIGRAVITY_CONVERSATION_ID"))

    def detect_session_id(self, repo_root: Optional[Path] = None) -> Optional[str]:
        # 1. Environment variable if available
        sid = os.environ.get("AGY_SESSION_ID") or os.environ.get("ANTIGRAVITY_CONVERSATION_ID")
        if sid:
            return sid

        # 2. Latest active session in brain matching repository
        brain = get_brain_dir()
        if not brain.exists():
            return None

        repo = repo_root or get_repo_root()
        repo_strs = {str(repo).lower(), repo.name.lower()}
        matching = []

        for cid_dir in brain.iterdir():
            if not cid_dir.is_dir() or cid_dir.name.startswith("."):
                continue
            t_path = cid_dir / ".system_generated" / "logs" / "transcript.jsonl"
            if not t_path.exists():
                continue

            try:
                mtime = t_path.stat().st_mtime
                with open(t_path, "r", encoding="utf-8", errors="replace") as f:
                    header = "".join([f.readline() for _ in range(25)]).lower()
                if any(r in header for r in repo_strs):
                    matching.append((mtime, cid_dir.name))
            except Exception:
                continue

        if matching:
            matching.sort(key=lambda x: x[0], reverse=True)
            return matching[0][1]

        return None

    def get_agent_identity(self, detected_model: Optional[str] = None) -> Tuple[str, str]:
        harness = "Antigravity CLI"
        try:
            out = subprocess.check_output(["agy", "--version"], text=True, stderr=subprocess.DEVNULL).strip()
            if out:
                harness = f"Antigravity CLI {out}"
        except Exception:
            pass
        return harness, detected_model or "Gemini 3.8 Flash (High)"

    def parse_transcript(
        self,
        transcript_path: Path,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        repo_root: Optional[Path] = None,
    ) -> Optional[Dict[str, Any]]:
        if not transcript_path.exists():
            return None

        full_transcript = transcript_path.parent / "transcript_full.jsonl"
        target_path = full_transcript if full_transcript.exists() else transcript_path

        steps = []
        with open(target_path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        steps.append(json.loads(line))
                    except json.JSONDecodeError:
                        continue

        if not steps:
            return None

        detected_model = None
        raw_turns: List[Tuple[str, str]] = []

        for step in steps:
            stype = step.get("type", "")
            source = step.get("source", "")
            content = step.get("content", "")
            created_at = step.get("created_at", "")

            if content and "Model Selection" in content:
                m = re.search(
                    r"Model Selection[`\x27]\s*from\s+.*?\s+to\s+([A-Za-z0-9\.\-_ \(\)]+?)(?:\.\s*No need|\.\n|\.$|<)",
                    content,
                )
                if m:
                    detected_model = m.group(1).strip()

            if stype == "USER_INPUT" or source == "USER_EXPLICIT":
                clean = clean_user_prompt(content)
                if clean:
                    raw_turns.append((format_utc(created_at), clean))

        prompts = process_prompt_turns(raw_turns, custom_patterns=custom_patterns)
        cid = transcript_path.parent.parent.parent.name
        if apply_session_excludes:
            prompts = apply_session_excludes_filter(cid, prompts, repo_root=repo_root, custom_patterns=custom_patterns)

        harness, model = self.get_agent_identity(detected_model)
        return {
            "session_id": cid,
            "detected_model": detected_model,
            "harness": harness,
            "prompts": prompts,
        }

    def find_session_data(
        self,
        session_id: Optional[str] = None,
        repo_root: Optional[Path] = None,
        max_age_seconds: Optional[int] = None,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        extra_options: Optional[Dict[str, Any]] = None,
    ) -> Optional[Dict[str, Any]]:
        brain = get_brain_dir()
        if not brain.exists():
            return None

        repo = repo_root or get_repo_root()
        if custom_patterns is None:
            custom_patterns = get_configured_exclude_patterns(repo_root=repo)

        effective_sid = session_id or self.detect_session_id(repo_root=repo)
        if effective_sid:
            t_path = brain / effective_sid / ".system_generated" / "logs" / "transcript.jsonl"
            if t_path.exists():
                return self.parse_transcript(
                    t_path,
                    custom_patterns=custom_patterns,
                    apply_session_excludes=apply_session_excludes,
                    repo_root=repo,
                )
            if session_id:
                return None

        # Auto-detect latest active session matching repo
        repo_strs = {str(repo).lower(), repo.name.lower()}
        matching = []
        now_ts = datetime.datetime.now().timestamp()

        for cid_dir in brain.iterdir():
            if not cid_dir.is_dir() or cid_dir.name.startswith("."):
                continue
            t_path = cid_dir / ".system_generated" / "logs" / "transcript.jsonl"
            if not t_path.exists():
                continue

            try:
                mtime = t_path.stat().st_mtime
                if max_age_seconds is not None and (now_ts - mtime) > max_age_seconds:
                    continue

                with open(t_path, "r", encoding="utf-8", errors="replace") as f:
                    header = "".join([f.readline() for _ in range(15)]).lower()
                if any(r in header for r in repo_strs):
                    matching.append((mtime, t_path))
            except Exception:
                continue

        if not matching:
            return None

        matching.sort(key=lambda x: x[0], reverse=True)
        return self.parse_transcript(
            matching[0][1],
            custom_patterns=custom_patterns,
            apply_session_excludes=apply_session_excludes,
            repo_root=repo,
        )


class ClaudeCodeAdapter(BaseIngestionAdapter):
    name = "claude"
    display_name = "Claude Code"

    def is_active(self, repo_root: Optional[Path] = None) -> bool:
        if os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("CLAUDE_CONVERSATION_ID"):
            return True
        if os.environ.get("CLAUDE_PROJECT_DIR"):
            return True
        return False

    def detect_session_id(self, repo_root: Optional[Path] = None) -> Optional[str]:
        return os.environ.get("CLAUDE_SESSION_ID") or os.environ.get("CLAUDE_CONVERSATION_ID")

    def get_agent_identity(self, detected_model: Optional[str] = None) -> Tuple[str, str]:
        harness = "Claude Code"
        try:
            out = subprocess.check_output(["claude", "--version"], text=True, stderr=subprocess.DEVNULL).strip()
            if out:
                harness = f"Claude Code {out}"
        except Exception:
            pass
        return harness, detected_model or "Claude 3.7 Sonnet"

    def _get_claude_dirs(self, repo_root: Optional[Path] = None) -> List[Path]:
        dirs = []
        custom = os.environ.get("CLAUDE_PROJECT_DIR")
        if custom:
            dirs.append(Path(custom))
        home_projects = Path(os.path.expanduser("~/.claude/projects"))
        if home_projects.exists():
            dirs.append(home_projects)
        home_sessions = Path(os.path.expanduser("~/.claude/sessions"))
        if home_sessions.exists():
            dirs.append(home_sessions)
        if repo_root:
            in_repo = repo_root / ".claude"
            if in_repo.exists():
                dirs.append(in_repo)
        return dirs

    def parse_transcript_file(
        self,
        transcript_path: Path,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        repo_root: Optional[Path] = None,
    ) -> Optional[Dict[str, Any]]:
        if not transcript_path.exists():
            return None

        entries = []
        try:
            with open(transcript_path, "r", encoding="utf-8", errors="replace") as f:
                content = f.read().strip()
                if content.startswith("[") and content.endswith("]"):
                    entries = json.loads(content)
                elif content.startswith("{") and content.endswith("}") and "\n" not in content.strip():
                    obj = json.loads(content)
                    if isinstance(obj, dict):
                        if "messages" in obj and isinstance(obj["messages"], list):
                            entries = obj["messages"]
                        else:
                            entries = [obj]
                else:
                    for line in content.splitlines():
                        line = line.strip()
                        if line:
                            try:
                                entries.append(json.loads(line))
                            except json.JSONDecodeError:
                                pass
        except Exception:
            return None

        if not entries:
            return None

        detected_model = None
        raw_turns: List[Tuple[str, str]] = []
        sid = transcript_path.stem

        for item in entries:
            if not isinstance(item, dict):
                continue

            if item.get("model"):
                detected_model = str(item["model"])
            elif isinstance(item.get("message"), dict) and item["message"].get("model"):
                detected_model = str(item["message"]["model"])

            if item.get("sessionId") or item.get("session_id"):
                sid = str(item.get("sessionId") or item.get("session_id"))

            role = item.get("role") or item.get("type") or ""
            if role in ("user", "user_input", "human") or (item.get("type") == "message" and item.get("message", {}).get("role") == "user"):
                text = ""
                raw_c = item.get("content") or item.get("message", {}).get("content") or item.get("text")
                if isinstance(raw_c, str):
                    text = raw_c
                elif isinstance(raw_c, list):
                    parts = []
                    for p in raw_c:
                        if isinstance(p, str):
                            parts.append(p)
                        elif isinstance(p, dict) and p.get("text"):
                            parts.append(str(p["text"]))
                    text = "\n".join(parts)

                clean = clean_user_prompt(text)
                if clean:
                    created_at = (
                        item.get("timestamp")
                        or item.get("created_at")
                        or item.get("time")
                        or item.get("date")
                        or ""
                    )
                    raw_turns.append((format_utc(str(created_at)), clean))

        if not raw_turns and not detected_model:
            return None

        prompts = process_prompt_turns(raw_turns, custom_patterns=custom_patterns)
        if apply_session_excludes:
            prompts = apply_session_excludes_filter(sid, prompts, repo_root=repo_root, custom_patterns=custom_patterns)

        harness, model = self.get_agent_identity(detected_model)
        return {
            "session_id": sid,
            "detected_model": detected_model,
            "harness": harness,
            "prompts": prompts,
        }

    def find_session_data(
        self,
        session_id: Optional[str] = None,
        repo_root: Optional[Path] = None,
        max_age_seconds: Optional[int] = None,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        extra_options: Optional[Dict[str, Any]] = None,
    ) -> Optional[Dict[str, Any]]:
        repo = repo_root or get_repo_root()
        if custom_patterns is None:
            custom_patterns = get_configured_exclude_patterns(repo_root=repo)

        env_transcript = os.environ.get("CLAUDE_TRANSCRIPT_PATH")
        if env_transcript and Path(env_transcript).exists():
            return self.parse_transcript_file(
                Path(env_transcript),
                custom_patterns=custom_patterns,
                apply_session_excludes=apply_session_excludes,
                repo_root=repo,
            )

        dirs = self._get_claude_dirs(repo_root=repo)
        if not dirs:
            return None

        effective_sid = session_id or self.detect_session_id(repo_root=repo)

        if effective_sid and Path(effective_sid).exists():
            return self.parse_transcript_file(
                Path(effective_sid),
                custom_patterns=custom_patterns,
                apply_session_excludes=apply_session_excludes,
                repo_root=repo,
            )

        candidates: List[Tuple[float, Path]] = []
        now_ts = datetime.datetime.now().timestamp()
        repo_strs = {str(repo).lower(), repo.name.lower()}

        for d in dirs:
            if not d.exists():
                continue
            files = []
            if d.is_file():
                files = [d]
            else:
                for p in d.rglob("*.json*"):
                    if p.is_file():
                        files.append(p)

            for fpath in files:
                if effective_sid and (effective_sid in fpath.stem or effective_sid in str(fpath)):
                    return self.parse_transcript_file(
                        fpath,
                        custom_patterns=custom_patterns,
                        apply_session_excludes=apply_session_excludes,
                        repo_root=repo,
                    )

                try:
                    mtime = fpath.stat().st_mtime
                    if max_age_seconds is not None and (now_ts - mtime) > max_age_seconds:
                        continue
                    fpath_str = str(fpath).lower()
                    if any(r in fpath_str for r in repo_strs):
                        candidates.append((mtime, fpath))
                except Exception:
                    continue

        if not candidates:
            return None

        candidates.sort(key=lambda x: x[0], reverse=True)
        for _, fpath in candidates:
            parsed = self.parse_transcript_file(
                fpath,
                custom_patterns=custom_patterns,
                apply_session_excludes=apply_session_excludes,
                repo_root=repo,
            )
            if parsed and parsed.get("prompts"):
                return parsed

        return None


class ManualAdapter(BaseIngestionAdapter):
    name = "manual"
    display_name = "Manual Entry"

    def is_active(self, repo_root: Optional[Path] = None) -> bool:
        return False

    def detect_session_id(self, repo_root: Optional[Path] = None) -> Optional[str]:
        return None

    def get_agent_identity(self, detected_model: Optional[str] = None) -> Tuple[str, str]:
        return "Manual", detected_model or "Manual"

    def find_session_data(
        self,
        session_id: Optional[str] = None,
        repo_root: Optional[Path] = None,
        max_age_seconds: Optional[int] = None,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        extra_options: Optional[Dict[str, Any]] = None,
    ) -> Optional[Dict[str, Any]]:
        extra = extra_options or {}
        msg = extra.get("message")
        if not msg:
            return None

        now_utc = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
        prompts = process_prompt_turns([(now_utc, msg.strip())], custom_patterns=custom_patterns)
        if not prompts:
            return None

        sid = session_id or f"manual-{datetime.datetime.now().strftime('%Y%m%d%H%M%S')}"
        if apply_session_excludes:
            prompts = apply_session_excludes_filter(sid, prompts, repo_root=repo_root, custom_patterns=custom_patterns)

        return {
            "session_id": sid,
            "detected_model": "Manual",
            "harness": "Manual",
            "prompts": prompts,
        }


# Backward compatibility alias
DirectAdapter = ManualAdapter


def get_configured_adapter(repo_root: Optional[Path] = None) -> Optional[str]:
    """Returns the explicitly configured adapter name from env or git config, if any."""
    env_val = os.environ.get("PROMPT_LOG_ADAPTER") or os.environ.get("GIT_PROMPT_LOG_ADAPTER")
    if env_val:
        v = env_val.strip().lower()
        return "manual" if v == "direct" else v
    code, out, _ = run_git(["config", "prompt-log.adapter"], repo_root=repo_root)
    if code == 0 and out.strip():
        v = out.strip().lower()
        return "manual" if v == "direct" else v
    return None


class AdapterRegistry:
    """Registry coordinating discovery and selection of assistant ingestion adapters."""

    def __init__(self):
        self._adapters: Dict[str, BaseIngestionAdapter] = {}
        self._order: List[str] = []

    def register(self, adapter: BaseIngestionAdapter) -> None:
        self._adapters[adapter.name] = adapter
        if adapter.name not in self._order:
            self._order.append(adapter.name)

    def get(self, name: str) -> Optional[BaseIngestionAdapter]:
        if name == "direct":
            return self._adapters.get("manual")
        return self._adapters.get(name)

    def list_adapters(self) -> List[BaseIngestionAdapter]:
        return [self._adapters[k] for k in self._order]

    def detect_active_adapter(
        self,
        repo_root: Optional[Path] = None,
        preferred_name: Optional[str] = None,
    ) -> Optional[BaseIngestionAdapter]:
        if preferred_name and preferred_name != "auto":
            return self.get(preferred_name)

        # 1. Check explicit user configuration (git config or PROMPT_LOG_ADAPTER env)
        configured = get_configured_adapter(repo_root=repo_root)
        if configured and configured != "auto":
            adapter = self.get(configured)
            if adapter:
                return adapter

        # 2. In-shell agent signals
        for name in self._order:
            if name == "manual":
                continue
            adapter = self._adapters[name]
            if adapter.is_active(repo_root=repo_root):
                return adapter
        return None

    def find_session_data(
        self,
        adapter_name: Optional[str] = None,
        session_id: Optional[str] = None,
        repo_root: Optional[Path] = None,
        max_age_seconds: Optional[int] = None,
        custom_patterns: Optional[List[str]] = None,
        apply_session_excludes: bool = True,
        extra_options: Optional[Dict[str, Any]] = None,
    ) -> Tuple[Optional[BaseIngestionAdapter], Optional[Dict[str, Any]]]:
        if adapter_name and adapter_name != "auto":
            adapter = self.get(adapter_name)
            if adapter:
                data = adapter.find_session_data(
                    session_id=session_id,
                    repo_root=repo_root,
                    max_age_seconds=max_age_seconds,
                    custom_patterns=custom_patterns,
                    apply_session_excludes=apply_session_excludes,
                    extra_options=extra_options,
                )
                return adapter, data
            return None, None

        if extra_options and extra_options.get("message"):
            manual = self.get("manual")
            if manual:
                data = manual.find_session_data(
                    session_id=session_id,
                    repo_root=repo_root,
                    max_age_seconds=max_age_seconds,
                    custom_patterns=custom_patterns,
                    apply_session_excludes=apply_session_excludes,
                    extra_options=extra_options,
                )
                if data:
                    return manual, data

        active = self.detect_active_adapter(repo_root=repo_root)
        if active:
            data = active.find_session_data(
                session_id=session_id,
                repo_root=repo_root,
                max_age_seconds=max_age_seconds,
                custom_patterns=custom_patterns,
                apply_session_excludes=apply_session_excludes,
                extra_options=extra_options,
            )
            if data:
                return active, data
            return None, None

        for name in self._order:
            if name == "manual":
                continue
            adapter = self._adapters[name]
            data = adapter.find_session_data(
                session_id=session_id,
                repo_root=repo_root,
                max_age_seconds=max_age_seconds,
                custom_patterns=custom_patterns,
                apply_session_excludes=apply_session_excludes,
                extra_options=extra_options,
            )
            if data:
                return adapter, data

        return None, None


REGISTRY = AdapterRegistry()
REGISTRY.register(AntigravityAdapter())
REGISTRY.register(ClaudeCodeAdapter())
REGISTRY.register(ManualAdapter())


def get_agent_identity() -> Tuple[str, str]:
    """Returns (harness_str, default_model_str) for active or default adapter."""
    adapter = REGISTRY.detect_active_adapter() or REGISTRY.get("antigravity")
    if adapter:
        return adapter.get_agent_identity()
    return "Antigravity CLI", "Gemini 3.8 Flash (High)"


def parse_session_transcript(
    transcript_path: Path,
    custom_patterns: Optional[List[str]] = None,
    apply_session_excludes: bool = True,
    repo_root: Optional[Path] = None,
) -> Optional[Dict]:
    """Parses transcript into user prompt turns (delegates to AntigravityAdapter)."""
    antigravity_adapter = REGISTRY.get("antigravity")
    if isinstance(antigravity_adapter, AntigravityAdapter):
        return antigravity_adapter.parse_transcript(
            transcript_path,
            custom_patterns=custom_patterns,
            apply_session_excludes=apply_session_excludes,
            repo_root=repo_root,
        )
    return None


def is_rebase_in_progress(repo_root: Optional[Path] = None) -> bool:
    """Checks if git is currently in the middle of a rebase or merge."""
    for dirname in ("rebase-merge", "rebase-apply"):
        code, path_out, _ = run_git(["rev-parse", "--git-path", dirname], repo_root=repo_root)
        if code == 0 and path_out:
            p = Path(path_out)
            if not p.is_absolute() and repo_root:
                p = repo_root / p
            if p.exists():
                return True
    return False


def find_session_transcript(
    session_id: Optional[str] = None,
    repo_root: Optional[Path] = None,
    max_age_seconds: Optional[int] = None,
    custom_patterns: Optional[List[str]] = None,
) -> Optional[Dict]:
    """Finds and parses the appropriate session transcript (delegates to REGISTRY)."""
    _, data = REGISTRY.find_session_data(
        adapter_name="auto",
        session_id=session_id,
        repo_root=repo_root,
        max_age_seconds=max_age_seconds,
        custom_patterns=custom_patterns,
    )
    return data


def cmd_adapters(args: argparse.Namespace) -> int:
    """Displays registered and active AI assistant ingestion adapters."""
    repo_root = get_repo_root()
    configured = get_configured_adapter(repo_root=repo_root)
    active = REGISTRY.detect_active_adapter(repo_root=repo_root)
    adapters = REGISTRY.list_adapters()

    if getattr(args, "json", False):
        info = {
            "configured": configured,
            "active": active.name if active else None,
            "adapters": [
                {
                    "name": a.name,
                    "display_name": a.display_name,
                    "active": (a == active) or a.is_active(repo_root=repo_root),
                    "detected_session": a.detect_session_id(repo_root=repo_root),
                }
                for a in adapters
            ],
        }
        print(json.dumps(info, indent=2))
        return 0

    if configured:
        print(f"Configured Harness: {configured} (git config prompt-log.adapter)\n")
    else:
        print("Configured Harness: None (auto-detect)\n")

    print("Registered Ingestion Adapters:")
    for a in adapters:
        is_act = (a == active) or a.is_active(repo_root=repo_root)
        status = "active" if is_act else "inactive"
        sid = a.detect_session_id(repo_root=repo_root)
        details = f"session: {sid}" if sid else status
        print(f"  * {a.name:<12} {a.display_name} ({details})")

    if active:
        sid = active.detect_session_id(repo_root=repo_root)
        print(f"\nActive Harness: {active.display_name}" + (f" (session: {sid})" if sid else ""))
    else:
        print("\nActive Harness: None (Standard Git / Human Shell)")
        print("\nTip: To explicitly set your default assistant harness, run:")
        print("  git prompt-log harness <antigravity|claude|manual>")
    return 0


def cmd_harness(args: argparse.Namespace) -> int:
    """Gets or sets the configured assistant harness / adapter."""
    repo_root = get_repo_root()
    name = getattr(args, "name", None)
    global_flag = ["--global"] if getattr(args, "global_config", False) else []

    if name in ("clear", "none", "auto"):
        run_git(["config"] + global_flag + ["--unset", "prompt-log.adapter"], repo_root=repo_root)
        scope = "globally" if global_flag else "for repository"
        print(f"Cleared configured harness ({scope}). Automatic detection restored.")
        return 0

    if name:
        target = "manual" if name == "direct" else name
        code, _, err = run_git(["config"] + global_flag + ["prompt-log.adapter", target], repo_root=repo_root)
        if code != 0:
            sys.stderr.write(f"Error setting git config: {err}\n")
            return 1
        scope = "globally" if global_flag else "for repository"
        print(f"Set active harness to '{target}' ({scope}, saved to git config prompt-log.adapter).")
        return 0

    configured = get_configured_adapter(repo_root=repo_root)
    active = REGISTRY.detect_active_adapter(repo_root=repo_root)
    if configured:
        print(f"Configured Harness: {configured} (git config prompt-log.adapter)")
    else:
        print("Configured Harness: None (auto-detect)")

    if active:
        sid = active.detect_session_id(repo_root=repo_root)
        print(f"Active Harness:     {active.display_name}" + (f" (session: {sid})" if sid else ""))
    else:
        print("Active Harness:     None (Standard Git / Human Shell)")
        print("\nTo set your harness explicitly, run:")
        print("  git prompt-log harness <antigravity|claude|manual>")
    return 0


# --- Core Command Implementations ---


def cmd_record(args: argparse.Namespace) -> int:
    """Attaches or updates a prompt note on a commit."""
    repo_root = get_repo_root()
    ref = args.ref

    # Resolve commit
    commit_target = args.commit or "HEAD"
    code, commit_out, err = run_git(["rev-parse", commit_target], repo_root=repo_root)
    if code != 0:
        sys.stderr.write(f"Error resolving commit '{commit_target}': {err}\n")
        return 1
    commit_hash = commit_out

    # Get commit date
    _, date_out, _ = run_git(["show", "-s", "--format=%cI", commit_hash], repo_root=repo_root)
    commit_date_utc = format_utc(date_out)

    configured_excludes = get_configured_exclude_patterns(repo_root=repo_root)
    exclude_patterns: List[str] = list(configured_excludes)
    if getattr(args, "exclude", None):
        if args.exclude not in exclude_patterns:
            exclude_patterns.append(args.exclude)

    message_input = getattr(args, "message", None)
    if getattr(args, "stdin", False):
        if not sys.stdin.isatty():
            message_input = sys.stdin.read().strip()
        elif not message_input:
            sys.stderr.write("Reading prompt from stdin (press Ctrl+D when finished):\n")
            message_input = sys.stdin.read().strip()

    extra_options = {"message": message_input}
    adapter_name = getattr(args, "adapter", "auto")

    adapter, session_data = REGISTRY.find_session_data(
        adapter_name=adapter_name,
        session_id=args.session,
        repo_root=repo_root,
        custom_patterns=exclude_patterns,
        extra_options=extra_options,
    )

    # If the commit already has existing notes, merge with them while preserving non-prompt content
    existing_raw = get_note_content(commit_hash, ref=ref, repo_root=repo_root) or ""
    prefix, _, suffix = extract_prompt_block(existing_raw)
    existing_notes = parse_notes(existing_raw)

    if not session_data:
        if existing_notes and (exclude_patterns or getattr(args, "drop_last", 0)):
            # Retroactively drop or prune existing note without needing an active session transcript
            all_notes = existing_notes
            session_id = existing_notes[-1].session_id
            target_prompts = []
        else:
            sys.stderr.write("No matching agent session transcript found.\n")
            return 1
    else:
        harness_def, def_model = adapter.get_agent_identity(session_data.get("detected_model")) if adapter else ("Unknown", "Unknown")
        harness = getattr(args, "harness", None) or session_data.get("harness") or harness_def
        model = getattr(args, "model", None) or session_data.get("detected_model") or def_model
        session_id = session_data["session_id"]
        all_prompts: List[PromptEntry] = session_data.get("prompts", [])

        commit_sort_ts = parse_timestamp_sort_key(commit_date_utc)
        target_prompts = []

        if adapter and adapter.name in ("manual", "direct"):
            target_prompts = list(all_prompts)
        else:
            for p in all_prompts:
                pts = parse_timestamp_sort_key(p.timestamp)
                if pts <= commit_sort_ts:
                    target_prompts.append(p)

            if not target_prompts and all_prompts:
                # Fallback to all session prompts if commit timestamp slightly precedes prompt log
                target_prompts = list(all_prompts)

        if exclude_patterns:
            target_prompts = [
                p for p in target_prompts
                if not any(_safe_search(pat, p.text) for pat in exclude_patterns)
            ]

        if getattr(args, "drop_last", 0) and args.drop_last > 0:
            target_prompts = target_prompts[:-args.drop_last]

        # Sort reverse-chronologically so causal prompt is at the top
        target_prompts.sort(key=lambda p: parse_timestamp_sort_key(p.timestamp), reverse=True)

        new_note = SessionNote(
            session_id=session_id,
            harness=harness,
            model=model,
            recorded_at=datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
            prompts=target_prompts,
        )

        other_notes = [n for n in existing_notes if n.session_id != session_id]
        all_notes = other_notes + [new_note]

    merged = merge_session_notes(all_notes)

    # Prune any prompts matching exclude patterns or session-specific excludes across all merged notes
    session_excludes = load_session_excludes(session_id, repo_root=repo_root)
    session_ts = set(session_excludes.get("timestamps", []))
    session_pats = session_excludes.get("patterns", [])

    if exclude_patterns or session_ts or session_pats:
        pruned_merged: List[SessionNote] = []
        for n in merged:
            kept_prompts = [
                p for p in n.prompts
                if p.timestamp not in session_ts
                and not any(_safe_search(pat, p.text) for pat in exclude_patterns)
                and not any(_safe_search(pat, p.text) for pat in session_pats)
            ]
            if kept_prompts:
                pruned_merged.append(
                    SessionNote(
                        session_id=n.session_id,
                        harness=n.harness,
                        model=n.model,
                        recorded_at=n.recorded_at,
                        prompts=kept_prompts,
                    )
                )
        merged = pruned_merged

    if not session_data and getattr(args, "drop_last", 0) and args.drop_last > 0:
        if merged and merged[-1].prompts:
            merged[-1].prompts = merged[-1].prompts[args.drop_last:]
            if not merged[-1].prompts:
                merged.pop()

    serialized_prompts = serialize_notes(merged)
    if serialized_prompts:
        final_note = wrap_prompt_block(serialized_prompts, prefix=prefix, suffix=suffix)
    elif prefix or suffix:
        final_note = (prefix.rstrip() + "\n\n" + suffix.lstrip()).strip()
    else:
        final_note = ""

    if getattr(args, "edit", False):
        editor = os.environ.get("GIT_EDITOR") or os.environ.get("EDITOR") or "nano"
        with tempfile.NamedTemporaryFile(mode="w+", suffix=".txt", delete=False) as tf:
            tf.write(final_note)
            temp_path = tf.name
        try:
            res = subprocess.run([editor, temp_path])
            if res.returncode == 0:
                final_note = Path(temp_path).read_text(encoding="utf-8")
        finally:
            if os.path.exists(temp_path):
                os.unlink(temp_path)

    if args.dry_run:
        print(f"--- Prompt Note for {commit_hash[:8]} ---")
        print(final_note.strip() if final_note.strip() else "(empty / removed)")
        return 0

    if not final_note.strip():
        remove_note_content(commit_hash, ref=ref, repo_root=repo_root)
        if not getattr(args, "quiet", False):
            print(f"Removed prompt note on {commit_hash[:8]}")
        return 0

    success = write_note_content(commit_hash, final_note, ref=ref, repo_root=repo_root)
    if success:
        if not getattr(args, "quiet", False):
            prompt_count = len(target_prompts) if session_data else sum(len(n.prompts) for n in merged)
            print(f"Recorded prompt note on {commit_hash[:8]} ({prompt_count} prompts in session {session_id[:8]})")
        return 0
    return 1


def cmd_post_commit(args: argparse.Namespace) -> int:
    """
    Called by .git/hooks/post-commit if installed.
    Strictly requires an active agent environment so human commits in ordinary shells are never hijacked.
    """
    repo_root = get_repo_root()
    if is_rebase_in_progress(repo_root):
        return 0

    # Strict causality guard: Only proceed if running within an explicit agent execution context
    active_adapter = REGISTRY.detect_active_adapter(repo_root=repo_root)
    if not active_adapter:
        return 0

    agent_session_id = active_adapter.detect_session_id(repo_root=repo_root)
    adapter, session_data = REGISTRY.find_session_data(
        adapter_name=active_adapter.name,
        session_id=agent_session_id,
        repo_root=repo_root,
    )
    if not session_data or not session_data.get("prompts"):
        return 0

    args.adapter = active_adapter.name
    args.commit = "HEAD"
    args.session = agent_session_id
    args.dry_run = False
    args.quiet = True
    return cmd_record(args)


def cmd_post_rewrite(args: argparse.Namespace) -> int:
    """
    Called by .git/hooks/post-rewrite on rebase, amend, or squash.
    Reads '<old-sha> <new-sha>' pairs from stdin.
    Intelligently merges notes from squashed commits according to session semantics.
    """
    repo_root = get_repo_root()
    ref = args.ref

    lines = sys.stdin.read().strip().splitlines()
    if not lines:
        return 0

    rewrites: Dict[str, List[str]] = defaultdict(list)
    for line in lines:
        parts = line.strip().split()
        if len(parts) >= 2:
            old_sha, new_sha = parts[0], parts[1]
            rewrites[new_sha].append(old_sha)

    modified_count = 0
    for new_sha, old_shas in rewrites.items():
        all_notes: List[SessionNote] = []
        prefix = ""
        suffix = ""

        # Read notes from all source commits
        for o_sha in old_shas:
            raw = get_note_content(o_sha, ref=ref, repo_root=repo_root)
            if raw:
                pre, _, suf = extract_prompt_block(raw)
                if pre and not prefix:
                    prefix = pre
                if suf and not suffix:
                    suffix = suf
                all_notes.extend(parse_notes(raw))

        # Also check if new_sha already has notes (e.g. from post-commit hook during amend)
        new_raw = get_note_content(new_sha, ref=ref, repo_root=repo_root)
        if new_raw:
            pre, _, suf = extract_prompt_block(new_raw)
            if pre and not prefix:
                prefix = pre
            if suf and not suffix:
                suffix = suf
            all_notes.extend(parse_notes(new_raw))

        if not all_notes:
            continue

        merged = merge_session_notes(all_notes)
        serialized_prompts = serialize_notes(merged)
        final_note = wrap_prompt_block(serialized_prompts, prefix=prefix, suffix=suffix)
        if write_note_content(new_sha, final_note, ref=ref, repo_root=repo_root):
            modified_count += 1

    if args.verbose and modified_count > 0:
        print(f"git-prompt-log: Updated prompt notes on {modified_count} rewritten commits.")
    return 0


def cmd_show(args: argparse.Namespace) -> int:
    """Displays the prompt note attached to a commit."""
    repo_root = get_repo_root()
    target = args.commit or "HEAD"
    code, commit_out, err = run_git(["rev-parse", target], repo_root=repo_root)
    if code != 0:
        sys.stderr.write(f"Error resolving commit '{target}': {err}\n")
        return 1

    content = get_note_content(commit_out, ref=args.ref, repo_root=repo_root)
    if not content:
        sys.stderr.write(f"No prompt note on commit {commit_out[:8]}.\n")
        return 1

    if getattr(args, "active", False):
        notes = parse_notes(content)
        if not notes or not notes[0].prompts:
            sys.stderr.write(f"No prompts found in note on commit {commit_out[:8]}.\n")
            return 1
        active_p = max(notes[0].prompts, key=lambda p: parse_timestamp_sort_key(p.timestamp))
        print(f"[{active_p.timestamp}] {active_p.text}")
        return 0

    if getattr(args, "incremental", False):
        code_p, parent_out, _ = run_git(["rev-parse", f"{commit_out}~1"], repo_root=repo_root)
        parent_prompt_keys = set()
        if code_p == 0 and parent_out:
            parent_raw = get_note_content(parent_out.strip(), ref=args.ref, repo_root=repo_root)
            if parent_raw:
                for pn in parse_notes(parent_raw):
                    for p in pn.prompts:
                        parent_prompt_keys.add((parse_timestamp_sort_key(p.timestamp), p.text.strip()))

        notes = parse_notes(content)
        inc_prompts = []
        for n in notes:
            for p in n.prompts:
                key = (parse_timestamp_sort_key(p.timestamp), p.text.strip())
                if key not in parent_prompt_keys:
                    inc_prompts.append(p)

        if not inc_prompts and notes and notes[-1].prompts:
            inc_prompts = [notes[-1].prompts[-1]]

        for p in inc_prompts:
            print(f"[{p.timestamp}] {p.text}")
        return 0

    print(content.strip())
    return 0


def get_default_branch_range(repo_root: Path) -> str:
    """Determines a sensible default revision range for the current branch."""
    code, branch, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"], repo_root=repo_root)
    current_branch = branch.strip() if code == 0 else ""

    # 1. Upstream tracking branch (if different from current)
    code, out, _ = run_git(["rev-parse", "--abbrev-ref", "@{u}"], repo_root=repo_root)
    if code == 0 and out.strip() and out.strip() != current_branch:
        return f"{out.strip()}..HEAD"

    # 2. Origin/main or origin/master (if not currently on that branch)
    for b in ("origin/main", "origin/master", "main", "master"):
        if b != current_branch:
            c, _, _ = run_git(["rev-parse", "--verify", b], repo_root=repo_root)
            if c == 0:
                return f"{b}..HEAD"

    return "HEAD~1..HEAD"


def get_default_slug(repo_root: Path) -> str:
    """Derives a concise snake_case slug from branch name or latest commit subject."""
    code, branch, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"], repo_root=repo_root)
    if code == 0 and branch and branch not in ("HEAD", "main", "master"):
        name = branch.replace("/", "_").replace("-", "_")
    else:
        code, subj, _ = run_git(["log", "-n", "1", "--format=%s", "HEAD"], repo_root=repo_root)
        name = subj or "session"
    cleaned = re.sub(r"[^a-zA-Z0-9]+", "_", name).strip("_").lower()
    return cleaned or "feature"


def should_use_color(color_arg: str = "auto", repo_root: Optional[Path] = None) -> bool:
    """Determines whether colored terminal output should be used."""
    if color_arg == "always":
        return True
    if color_arg == "never":
        return False
    # auto: respect NO_COLOR env var and isatty
    if os.environ.get("NO_COLOR"):
        return False
    if not sys.stdout.isatty():
        return False
    if repo_root:
        code, out, _ = run_git(["config", "--get", "color.ui"], repo_root=repo_root)
        if code == 0 and out.strip().lower() in ("false", "never"):
            return False
    return True


def pipe_to_pager(text: str, repo_root: Optional[Path] = None):
    """Pipes text output through the configured Git/system pager."""
    if not sys.stdout.isatty():
        sys.stdout.write(text)
        return

    pager = os.environ.get("GIT_PAGER")
    if not pager and repo_root:
        c, out, _ = run_git(["var", "GIT_PAGER"], repo_root=repo_root)
        if c == 0 and out.strip():
            pager = out.strip()
    if not pager:
        pager = os.environ.get("PAGER", "less")

    if pager in ("cat", ""):
        sys.stdout.write(text)
        return

    env = os.environ.copy()
    if "LESS" not in env:
        env["LESS"] = "FRX"
    if "LV" not in env:
        env["LV"] = "-c"

    try:
        proc = subprocess.Popen(pager, shell=True, stdin=subprocess.PIPE, text=True, encoding="utf-8", env=env)
        try:
            proc.communicate(input=text)
        except (BrokenPipeError, KeyboardInterrupt):
            pass
    except Exception:
        sys.stdout.write(text)


def cmd_log(args: argparse.Namespace) -> int:
    """Displays commits in range with their active steering prompts."""
    repo_root = get_repo_root()
    commit_range = getattr(args, "range", None) or "HEAD"
    git_cmd = ["log", "--format=%H %s"]
    if getattr(args, "max_count", None):
        git_cmd.extend(["-n", str(args.max_count)])
    git_cmd.append(commit_range)

    code, log_out, _ = run_git(git_cmd, repo_root=repo_root)
    if code != 0 or not log_out.strip():
        limit = getattr(args, "max_count", 10) or 10
        code, log_out, _ = run_git(["log", "--format=%H %s", "-n", str(limit), "HEAD"], repo_root=repo_root)
        if code != 0 or not log_out.strip():
            return 0

    use_color = should_use_color(getattr(args, "color", "auto"), repo_root=repo_root)
    c_yellow = "\033[33m" if use_color else ""
    c_bold = "\033[1m" if use_color else ""
    c_cyan = "\033[36m" if use_color else ""
    c_reset = "\033[0m" if use_color else ""

    lines = []
    commits = [line.split(" ", 1) for line in log_out.splitlines() if line.strip()]
    for parts in commits:
        c_hash = parts[0]
        subj = parts[1] if len(parts) > 1 else ""
        note_raw = get_note_content(c_hash, ref=args.ref, repo_root=repo_root)
        lines.append(f"* {c_yellow}{c_hash[:8]}{c_reset} {c_bold}{subj}{c_reset}")
        if note_raw:
            notes = parse_notes(note_raw)
            if notes and notes[0].prompts:
                if getattr(args, "full", False):
                    for p in notes[0].prompts:
                        indented = p.text.replace("\n", "\n    ")
                        lines.append(f"  {c_cyan}[{p.timestamp}]{c_reset} {indented}")
                else:
                    active_p = max(notes[0].prompts, key=lambda p: parse_timestamp_sort_key(p.timestamp))
                    indented = active_p.text.replace("\n", "\n    ")
                    lines.append(f"  {c_cyan}[{active_p.timestamp}]{c_reset} {indented}")
        lines.append("")

    full_output = "\n".join(lines)
    if not full_output.endswith("\n"):
        full_output += "\n"

    no_pager = getattr(args, "no_pager", False) or getattr(args, "global_no_pager", False)
    if no_pager:
        sys.stdout.write(full_output)
    else:
        pipe_to_pager(full_output, repo_root=repo_root)

    return 0


def cmd_export_log(args: argparse.Namespace) -> int:
    """
    Exports prompt notes from a commit range to a human-readable Markdown log file
    with an embedded JSON envelope for lossless re-hydration.
    """
    repo_root = get_repo_root()
    ref = args.ref
    commit_range = args.range or get_default_branch_range(repo_root)

    # Resolve commits in range in chronological order
    code, out, err = run_git(["rev-list", "--reverse", commit_range], repo_root=repo_root)
    if code != 0 or not out.strip():
        # Fallback to single HEAD commit if range rev-list was empty
        code, head_sha, _ = run_git(["rev-parse", "HEAD"], repo_root=repo_root)
        commit_shas = [head_sha] if code == 0 and head_sha else []
    else:
        commit_shas = [line.strip() for line in out.strip().splitlines() if line.strip()]

    if not commit_shas:
        sys.stderr.write(f"Error: No commits found in range '{commit_range}'.\n")
        return 1

    commit_entries = []
    all_session_notes = []
    for sha in commit_shas:
        c_code, c_subj, _ = run_git(["log", "-n", "1", "--format=%s", sha], repo_root=repo_root)
        raw = get_note_content(sha, ref=ref, repo_root=repo_root)
        notes = parse_notes(raw) if raw else []
        if notes:
            commit_entries.append({
                "hash": sha,
                "subject": c_subj or "",
                "note_raw": raw.strip(),
                "notes": notes,
            })
            all_session_notes.extend(notes)

    if not commit_entries:
        sys.stderr.write(f"Warning: No prompt notes found on commits in range '{commit_range}'.\n")
        return 1

    merged_sessions = merge_session_notes(all_session_notes)
    slug = args.slug or get_default_slug(repo_root)
    now_utc = datetime.datetime.now(datetime.timezone.utc)
    ts_file = now_utc.strftime("%Y_%m_%d_%H%M%S")
    ts_human = now_utc.strftime("%Y-%m-%d %H:%M:%S UTC")

    # Generate Markdown content
    lines = []
    lines.append(f"# Prompt Log: {slug.replace('_', ' ').title()}")
    lines.append("")
    lines.append(f"- **Exported:** {ts_human}")
    for s in merged_sessions:
        lines.append(f"- **Session:** `{s.session_id}`")
        lines.append(f"- **Harness:** {s.harness}")
        lines.append(f"- **Model:** {s.model}")
    lines.append("")
    lines.append("## Commits")
    lines.append("")
    for c in commit_entries:
        lines.append(f"- `{c['hash'][:8]}` {c['subject']}")
    lines.append("")
    lines.append("## Steering Prompts")
    lines.append("")
    for s in merged_sessions:
        if len(merged_sessions) > 1:
            lines.append(f"### Session `{s.session_id[:8]}` ({s.model})")
            lines.append("")
        for p in sorted(s.prompts, key=lambda p: parse_timestamp_sort_key(p.timestamp)):
            lines.append(f"#### [{p.timestamp}]")
            lines.append("")
            lines.append(f"> {p.text.replace(chr(10), chr(10) + '> ')}")
            lines.append("")

    # Machine-readable envelope for lossless import
    envelope = {
        "version": 1,
        "exported_at": ts_human,
        "slug": slug,
        "commits": [
            {
                "hash": c["hash"],
                "subject": c["subject"],
                "note": c["note_raw"],
            }
            for c in commit_entries
        ],
    }
    lines.append("<!-- git-prompt-log:metadata")
    lines.append(json.dumps(envelope, indent=2))
    lines.append("-->")
    lines.append("")

    md_content = "\n".join(lines)

    if getattr(args, "stdout", False):
        sys.stdout.write(md_content)
        return 0

    if args.output:
        out_path = Path(args.output)
        if not out_path.is_absolute():
            out_path = repo_root / out_path
    else:
        out_path = repo_root / "prompts" / f"{ts_file}_{slug}.md"

    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(md_content, encoding="utf-8")
    rel_path = out_path.relative_to(repo_root) if out_path.is_relative_to(repo_root) else out_path
    print(f"Exported prompt log to {rel_path}")

    if getattr(args, "commit", False):
        run_git(["add", str(out_path)], repo_root=repo_root)
        commit_msg = f"prompts: Export prompt log for {slug.replace('_', ' ')}"
        c_code, _, c_err = run_git(["commit", "-m", commit_msg], repo_root=repo_root)
        if c_code == 0:
            print(f"Committed prompt log: '{commit_msg}'")
        else:
            sys.stderr.write(f"Failed to commit prompt log: {c_err}\n")
            return 1

    return 0


def cmd_import_log(args: argparse.Namespace) -> int:
    """
    Imports prompt notes from an exported log file back into Git notes (refs/notes/commits).
    Reconciles commits by exact hash, or falls back to matching by commit subject if squashed/rebased.
    """
    repo_root = get_repo_root()
    ref = args.ref
    log_file = Path(args.file)
    if not log_file.is_absolute():
        log_file = repo_root / log_file

    if not log_file.is_file():
        sys.stderr.write(f"Error: Log file '{log_file}' not found.\n")
        return 1

    content = log_file.read_text(encoding="utf-8")

    # Extract metadata block if present
    meta_m = re.search(r"<!-- (?:git-prompt-log|git-prompt-note):metadata\s*(.*?)\s*-->", content, re.DOTALL)
    imported_count = 0

    if meta_m:
        try:
            data = json.loads(meta_m.group(1))
            commits_data = data.get("commits", [])
        except Exception as e:
            sys.stderr.write(f"Error parsing metadata envelope: {e}\n")
            return 1

        for c_entry in commits_data:
            orig_hash = c_entry.get("hash", "")
            subject = c_entry.get("subject", "")
            note_raw = c_entry.get("note", "")
            if not note_raw:
                continue

            target_sha = None

            # Explicit commit override
            if args.commit:
                target_sha = args.commit
            else:
                # Check if exact hash exists and is reachable from HEAD in current repository
                if orig_hash:
                    c, out, _ = run_git(["rev-parse", "--verify", f"{orig_hash}^{{commit}}"], repo_root=repo_root)
                    if c == 0:
                        resolved = out.strip()
                        anc_c, _, _ = run_git(["merge-base", "--is-ancestor", resolved, "HEAD"], repo_root=repo_root)
                        if anc_c == 0:
                            target_sha = resolved

                # If exact hash is not reachable on HEAD, search for commit with matching subject
                if not target_sha and subject:
                    c, out, _ = run_git(["log", "-n", "50", "--format=%H %s"], repo_root=repo_root)
                    if c == 0:
                        for line in out.strip().splitlines():
                            parts = line.split(" ", 1)
                            if len(parts) == 2 and parts[1].strip() == subject.strip():
                                target_sha = parts[0].strip()
                                break

            if not target_sha:
                # Fallback to HEAD if single commit entry and nowhere else to attach
                if len(commits_data) == 1:
                    c, out, _ = run_git(["rev-parse", "HEAD"], repo_root=repo_root)
                    if c == 0:
                        target_sha = out.strip()

            if target_sha:
                # Parse existing note and merge
                existing_raw = get_note_content(target_sha, ref=ref, repo_root=repo_root) or ""
                prefix, _, suffix = extract_prompt_block(existing_raw)
                existing_notes = parse_notes(existing_raw)
                incoming_notes = parse_notes(note_raw)

                merged = merge_session_notes(existing_notes + incoming_notes)
                serialized = serialize_notes(merged)
                final_note = wrap_prompt_block(serialized, prefix=prefix, suffix=suffix)

                if write_note_content(target_sha, final_note, ref=ref, repo_root=repo_root):
                    print(f"Imported prompt note for {target_sha[:8]} ('{subject}')")
                    imported_count += 1
            else:
                sys.stderr.write(f"Warning: Could not resolve target commit for '{subject}' ({orig_hash[:8]}).\n")
    else:
        # Plain markdown fallback: parse the note block directly from content
        parsed = parse_notes(content)
        if not parsed:
            sys.stderr.write("Error: No parseable prompt notes or metadata found in log file.\n")
            return 1

        target_sha = args.commit or "HEAD"
        c, out, _ = run_git(["rev-parse", target_sha], repo_root=repo_root)
        if c != 0:
            sys.stderr.write(f"Error resolving target commit '{target_sha}'.\n")
            return 1
        resolved_sha = out.strip()

        existing_raw = get_note_content(resolved_sha, ref=ref, repo_root=repo_root) or ""
        prefix, _, suffix = extract_prompt_block(existing_raw)
        existing_notes = parse_notes(existing_raw)
        merged = merge_session_notes(existing_notes + parsed)
        serialized = serialize_notes(merged)
        final_note = wrap_prompt_block(serialized, prefix=prefix, suffix=suffix)

        if write_note_content(resolved_sha, final_note, ref=ref, repo_root=repo_root):
            print(f"Imported prompt note for {resolved_sha[:8]} from markdown")
            imported_count += 1

    return 0 if imported_count > 0 else 1


def cmd_session(args: argparse.Namespace) -> int:
    """Inspects and manages prompt exclusions for a specific agent session."""
    repo_root = get_repo_root()
    action = getattr(args, "action", "list") or "list"
    session_id = getattr(args, "session", None)

    brain = get_brain_dir()
    if session_id:
        t_path = brain / session_id / ".system_generated" / "logs" / "transcript.jsonl"
        if not t_path.exists():
            sys.stderr.write(f"Session transcript not found for session ID: {session_id}\n")
            return 1
    else:
        env_sid = os.environ.get("AGY_SESSION_ID") or os.environ.get("ANTIGRAVITY_CONVERSATION_ID")
        if env_sid:
            t_path = brain / env_sid / ".system_generated" / "logs" / "transcript.jsonl"
            if t_path.exists():
                session_id = env_sid
        if not session_id:
            found = find_session_transcript(repo_root=repo_root)
            if not found:
                sys.stderr.write("No active agent session transcript found.\n")
                return 1
            session_id = found["session_id"]
            t_path = brain / session_id / ".system_generated" / "logs" / "transcript.jsonl"

    session_excludes = load_session_excludes(session_id, repo_root=repo_root)
    raw_data = parse_session_transcript(t_path, apply_session_excludes=False, repo_root=repo_root)
    if not raw_data:
        sys.stderr.write(f"No prompts found in session {session_id}.\n")
        return 1

    all_prompts: List[PromptEntry] = raw_data.get("prompts", [])
    pat_list = session_excludes.get("patterns", [])
    ts_list = session_excludes.get("timestamps", [])
    idx_set = set(session_excludes.get("indices", []))

    if action in ("list", "show"):
        print(f"Session: {session_id} ({len(all_prompts)} prompts)")
        for i, p in enumerate(all_prompts, start=1):
            is_excluded = (
                i in idx_set
                or p.timestamp in ts_list
                or any(_safe_search(pat, p.text) for pat in pat_list)
            )
            status = " [EXCLUDED]" if is_excluded else ""
            first_line = p.text.splitlines()[0] if p.text else ""
            if len(p.text.splitlines()) > 1:
                first_line += "..."
            print(f"  [{i}] {p.timestamp}{status}")
            print(f"      {first_line}")
        return 0

    elif action in ("drop", "exclude"):
        target = getattr(args, "target", None)
        if not target:
            sys.stderr.write("Error: drop requires an index (e.g. 2) or regex pattern (e.g. 'Commit')\n")
            return 1

        if target.isdigit():
            idx = int(target)
            if idx < 1 or idx > len(all_prompts):
                sys.stderr.write(f"Error: index {idx} out of range (1-{len(all_prompts)})\n")
                return 1
            target_prompt = all_prompts[idx - 1]
            if target_prompt.timestamp not in session_excludes.setdefault("timestamps", []):
                session_excludes["timestamps"].append(target_prompt.timestamp)
            save_session_excludes(session_id, session_excludes, repo_root=repo_root)
            first_line = target_prompt.text.splitlines()[0] if target_prompt.text else ""
            print(f"Excluded prompt [{idx}] from session {session_id[:8]}: {first_line}")
        else:
            if target not in session_excludes.setdefault("patterns", []):
                session_excludes["patterns"].append(target)
            save_session_excludes(session_id, session_excludes, repo_root=repo_root)
            print(f"Excluded prompts matching '{target}' from session {session_id[:8]}.")

        if not getattr(args, "no_update", False):
            commit_target = getattr(args, "commit", "HEAD") or "HEAD"
            rec_args = argparse.Namespace(
                commit=commit_target,
                session=session_id,
                ref=args.ref,
                exclude=None,
                drop_last=0,
                edit=False,
                quiet=True,
                dry_run=False,
            )
            cmd_record(rec_args)
            print(f"Updated prompt note on {commit_target}.")
        return 0

    elif action in ("undrop", "restore"):
        target = getattr(args, "target", None)
        if not target:
            sys.stderr.write("Error: undrop requires an index (e.g. 2) or regex pattern (e.g. 'Commit')\n")
            return 1

        modified = False
        if target.isdigit():
            idx = int(target)
            if idx < 1 or idx > len(all_prompts):
                sys.stderr.write(f"Error: index {idx} out of range (1-{len(all_prompts)})\n")
                return 1
            target_prompt = all_prompts[idx - 1]
            if target_prompt.timestamp in session_excludes.get("timestamps", []):
                session_excludes["timestamps"].remove(target_prompt.timestamp)
                modified = True
            if idx in session_excludes.get("indices", []):
                session_excludes["indices"].remove(idx)
                modified = True
        else:
            if target in session_excludes.get("patterns", []):
                session_excludes["patterns"].remove(target)
                modified = True

        if modified:
            save_session_excludes(session_id, session_excludes, repo_root=repo_root)
            print(f"Restored prompt '{target}' in session {session_id[:8]}.")
            if not getattr(args, "no_update", False):
                commit_target = getattr(args, "commit", "HEAD") or "HEAD"
                rec_args = argparse.Namespace(
                    commit=commit_target,
                    session=session_id,
                    ref=args.ref,
                    exclude=None,
                    drop_last=0,
                    edit=False,
                    quiet=True,
                    dry_run=False,
                )
                cmd_record(rec_args)
                print(f"Updated prompt note on {commit_target}.")
        else:
            print(f"No active exclusion found for '{target}' in session {session_id[:8]}.")
        return 0

    elif action == "clear":
        session_excludes = {"patterns": [], "indices": [], "timestamps": []}
        save_session_excludes(session_id, session_excludes, repo_root=repo_root)
        print(f"Cleared all exclusions for session {session_id[:8]}.")
        if not getattr(args, "no_update", False):
            commit_target = getattr(args, "commit", "HEAD") or "HEAD"
            rec_args = argparse.Namespace(
                commit=commit_target,
                session=session_id,
                ref=args.ref,
                exclude=None,
                drop_last=0,
                edit=False,
                quiet=True,
                dry_run=False,
            )
            cmd_record(rec_args)
            print(f"Updated prompt note on {commit_target}.")
        return 0

    else:
        sys.stderr.write(f"Unknown session action: {action}\n")
        return 1


DEFAULT_SKILL_MD = """---
name: git-prompt-log
description: >-
  Attaches AI session metadata, model/harness provenance, and human steering prompts
  directly to git notes on commits, provides deterministic prompt deduplication
  across git rebase/squash, exports branch prompt logs for pull requests, and
  re-hydrates prompt notes from merged logs. Use when authoring commits, recording
  prompt notes, finalizing a feature branch, preparing a pull request, or landing
  PR prompt logs.
---

# Antigravity Git Prompt Log Skill

Attaches AI session metadata, harness details, and human steering ("navigator") prompts directly to commits via standard Git notes (`refs/notes/commits`).

---

## Why Git Notes

Traditional prompt tracking either pollutes the git tree with markdown files (`prompts/*.md`) and requires rewriting commit trailers (`Prompt-Log:`), or relies on heavyweight daemons and full transcript logging (`git ai`) that bloats repositories and risks PII leakage.

`git-prompt-log` records the essential provenance directly onto git commits without altering commit hashes or tree objects:
1. **Prompts over Transcripts:** Only the human steering prompts that set the course are stored; the patch itself already contains the code.
2. **Zero Tree Pollution:** Git notes live in `refs/notes/commits` outside the commit DAG during active development.
3. **Deterministic Rewrites:** Intelligent post-rewrite handling preserves, deduplicates, and merges session notes across `git rebase -i`, `squash`, `fixup`, and `commit --amend`.
4. **Hybrid PR Workflow:** At the PR boundary, accumulated notes on the branch can be exported to a single reviewable markdown commit (`git prompt-log export-log --commit`), and re-hydrated back into upstream notes upon landing (`git prompt-log import-log <file>`).
---

## Schema

```text
Assistant-Session: 9674eda6-390f-4b1d-9910-72bec1843401
Assistant-Harness: Antigravity CLI 1.1.25
Assistant-Model: Gemini 3.8 Flash (High)
Assistant-Recorded: 2026-09-04 01:03:57 UTC

Assistant-Prompts:
  [2026-09-04 01:03:57 UTC] Pivot camera around ball origin
  [2026-09-04 01:09:25 UTC] Let's implement this.
```

When squashing commits across different sessions, each session is preserved sequentially separated by `---`:

```text
Assistant-Session: 147638d8-6fb3-46df-a685-441b1aec2349
Assistant-Harness: Antigravity CLI 1.1.24
Assistant-Model: Gemini 3.8 Flash (High)
Assistant-Recorded: 2026-09-02 18:30:12 UTC

Assistant-Prompts:
  [2026-09-02 18:25:01 UTC] Refactor camera mapping

---

Assistant-Session: 9674eda6-390f-4b1d-9910-72bec1843401
Assistant-Harness: Antigravity CLI 1.1.25
Assistant-Model: Gemini 3.8 Flash (High)
Assistant-Recorded: 2026-09-04 01:03:57 UTC

Assistant-Prompts:
  [2026-09-04 01:02:10 UTC] Fix pitch clamping
```

---

## Agent Runbook

### 1. After Authoring a Commit (Local Recording)
Whenever an agent creates or amends a commit on behalf of the user, record the steering prompts on `HEAD`:

```bash
git prompt-log record
```

To view the recorded note on a commit:
```bash
git prompt-log show HEAD
```

### 2. Preparing a Feature Branch for PR (Export Log)
When a feature branch is complete and ready for pull request review, export the branch's accumulated prompt notes into a reviewable log commit:

```bash
# Automatically detects branch range (e.g. main..HEAD), writes prompts/YYYY_MM_DD_<slug>.md, and commits it
git prompt-log export-log --commit
```

The exported file contains:
- Human-readable session metadata and steering prompts for reviewers in the web PR diff.
- An embedded metadata block that enables exact upstream re-hydration.

### 3. Maintainer / Post-Merge (Import Log)
After a PR is merged (even if squashed or rebased via GitHub's web UI), the maintainer re-hydrates the notes onto the landed commits on `main`:

```bash
git prompt-log import-log prompts/2026_09_04_feature.md
```

---

## Accidental Prompts & Parallel Sessions

When running multiple agent sessions in parallel across different projects, accidental prompts can be prevented or retracted using simple markers:

1. **Tag an Accidental Prompt Directly:**
   Prefix the prompt with `[ignore]`, `[skip]`, `[wrong-session]`, or `[scratch]`:
   ```text
   [wrong-session] Fix the audio mixer volume slider
   ```
   Such prompts are automatically excluded from prompt notes.

2. **Retract an Already-Sent Accidental Prompt:**
   If a prompt was sent by mistake, follow up in that same session with:
   ```text
   [ignore-last]
   ```
   (or `[wrong-session]`, `[ignore-prev]`, `[retract]`).
   This drops the preceding accidental prompt (and drops the retraction marker).
   To drop multiple accidental prompts: `[ignore-last 2]`.
   To reset all prompts accumulated in the session: `[ignore-all]`.

3. **Retract and Provide Real Prompt in One Turn:**
   ```text
   [ignore-last] Actually, fix the level select camera
   ```
   Drops the previous message and records only the intended prompt.

4. **Filtering and Editing Notes:**
   ```bash
   # Exclude prompts matching a regex when recording
   git prompt-log record --drop "audio mixer"

   # Drop last prompt when recording
   git prompt-log record --drop-last 1

   # Edit recorded note interactively in $EDITOR
   git prompt-log edit HEAD
   ```

---

## CLI Reference

```bash
# Initialize / install in a repository (hooks, local git config; default: no skill)
git prompt-log install
# (or git prompt-log init)

# Install with local repository assistant skill
git prompt-log install --skill

# Uninstall hooks
git prompt-log uninstall-hook

# Completely remove hooks, git config, and local skill
git prompt-log uninstall-hook --all

# Record prompt note on HEAD (or --commit <hash>)
git prompt-log record

# Preview prompt note without writing to git
git prompt-log record --dry-run

# Show prompt note on a commit
git prompt-log show [commit]

# Edit prompt note on a commit in $EDITOR
git prompt-log edit [commit]

# Export branch prompt notes to a markdown log file
git prompt-log export-log [--range <base>..HEAD] [--output <file>] [--commit]

# Import prompt notes from a log file into git notes
git prompt-log import-log <file> [--commit <hash>]
```

---

## Rebase and Squash Handling

When Git rewrites commits (`rebase`, `commit --amend`, `squash`, `fixup`), the installed `.git/hooks/post-rewrite` hook invokes `git prompt-log post-rewrite`:

1. **Same-Session Squash:** Prompts from all squashed commits are unioned, deduplicated, and sorted chronologically into a single session entry with the latest `Recorded` timestamp.
2. **Cross-Session Squash:** Multiple session entries are preserved in chronological order separated by `---`.
3. **1-to-1 Rebase / Amend:** The note is transferred to the new commit hash, appending newly executed steering prompts if amended within an active session.
"""


def _install_hook_file(hook_path: Path, hook_cmd: str, comment_title: str):
    """Safely creates or appends to a git hook file."""
    if hook_path.exists():
        existing = hook_path.read_text(encoding="utf-8")
        if "git prompt-log" in existing:
            print(f"{hook_path.name} hook is already installed.")
            return
        elif "git prompt-note" in existing or "git_prompt_note.py" in existing:
            # Upgrade legacy hook reference in place
            migrated = existing.replace("git prompt-note", "git prompt-log")
            migrated = migrated.replace("git_prompt_note.py", "git prompt-log")
            migrated = migrated.replace("# Git Prompt Note", f"# {comment_title}")
            hook_path.write_text(migrated, encoding="utf-8")
            hook_path.chmod(0o755)
            print(f"Migrated legacy hook to git-prompt-log in {hook_path.name}")
            return
        with open(hook_path, "a", encoding="utf-8") as f:
            f.write(f"\n# {comment_title}\n{hook_cmd}\n")
        print(f"Appended git-prompt-log to {hook_path}")
    else:
        content = f"""#!/bin/sh
# {comment_title}
{hook_cmd}
"""
        hook_path.write_text(content, encoding="utf-8")
        hook_path.chmod(0o755)
        print(f"Created executable hook at {hook_path}")


def cmd_install_hook(args: argparse.Namespace) -> int:
    """Installs post-rewrite and post-commit hooks and configures git rewrite settings."""
    repo_root = get_repo_root()
    common_git = get_common_git_dir(repo_root)
    hooks_dir = common_git / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)

    # 1. Install post-rewrite hook (safe automatic merger on squash / rebase / amend)
    post_rewrite_path = hooks_dir / "post-rewrite"
    post_rewrite_cmd = f'git prompt-log post-rewrite --ref="{args.ref}"'
    _install_hook_file(post_rewrite_path, post_rewrite_cmd, "Git Prompt Log rebase/squash merger")

    # 2. Install post-commit hook by default (strictly requires AGY_SESSION_ID / ANTIGRAVITY_CONVERSATION_ID)
    if getattr(args, "with_post_commit", True):
        post_commit_path = hooks_dir / "post-commit"
        post_commit_cmd = f'git prompt-log post-commit --ref="{args.ref}"'
        _install_hook_file(post_commit_path, post_commit_cmd, "Git Prompt Log agent post-commit hook")

    # 3. Set local git config for notes rewriting
    run_git(["config", "notes.rewrite.rebase", "true"], repo_root=repo_root)
    run_git(["config", "notes.rewrite.amend", "true"], repo_root=repo_root)
    run_git(["config", "notes.rewriteRef", args.ref], repo_root=repo_root)
    print(f"Git configured: notes.rewriteRef = {args.ref}")

    # 4. Explicitly configure default assistant harness / adapter if requested
    adapter_arg = getattr(args, "adapter", None)
    if adapter_arg and adapter_arg != "auto":
        target = "manual" if adapter_arg == "direct" else adapter_arg
        run_git(["config", "prompt-log.adapter", target], repo_root=repo_root)
        print(f"Git configured: prompt-log.adapter = {target}")

    # 5. If called via 'init' and with_skill is true, install local repository skill
    if getattr(args, "with_skill", False):
        skill_target = repo_root / ".agents" / "skills" / "git-prompt-log" / "SKILL.md"
        skill_target.parent.mkdir(parents=True, exist_ok=True)
        local_skill_src = Path(__file__).resolve().parent.parent / "SKILL.md"
        if local_skill_src.is_file():
            content = local_skill_src.read_text(encoding="utf-8")
        else:
            content = DEFAULT_SKILL_MD
        skill_target.write_text(content, encoding="utf-8")
        print(f"Installed local agent skill at {skill_target.relative_to(repo_root)}")

    return 0


def _uninstall_hook_file(hook_path: Path) -> bool:
    """Safely removes git-prompt-log commands from a hook file, deleting if empty."""
    if not hook_path.exists():
        return False

    raw = hook_path.read_text(encoding="utf-8")
    if (
        "git prompt-log" not in raw
        and "git prompt-note" not in raw
        and "git_prompt_log.py" not in raw
        and "git_prompt_note.py" not in raw
    ):
        return False

    lines = raw.splitlines()
    new_lines = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if (
            line.strip().startswith("# Git Prompt Log")
            or line.strip().startswith("# Git Prompt Note")
            or "git prompt-log" in line
            or "git prompt-note" in line
            or "git_prompt_log.py" in line
            or "git_prompt_note.py" in line
        ):
            i += 1
            continue
        new_lines.append(line)
        i += 1

    # Check for non-shebang, non-comment commands
    meaningful = [l.strip() for l in new_lines if l.strip() and not l.strip().startswith("#")]

    if not meaningful:
        hook_path.unlink()
        print(f"Removed hook file {hook_path.name}")
        return True
    else:
        content = "\n".join(new_lines).strip() + "\n"
        hook_path.write_text(content, encoding="utf-8")
        hook_path.chmod(0o755)
        print(f"Removed git-prompt-log from {hook_path.name}")
        return True


def cmd_uninstall_hook(args: argparse.Namespace) -> int:
    """Uninstalls git-prompt-log hooks, and optionally git config and skills."""
    repo_root = get_repo_root()
    common_git = get_common_git_dir(repo_root)
    hooks_dir = common_git / "hooks"

    remove_rewrite = True
    remove_commit = True

    if getattr(args, "post_commit_only", False):
        remove_rewrite = False
    elif getattr(args, "post_rewrite_only", False):
        remove_commit = False

    if remove_rewrite:
        _uninstall_hook_file(hooks_dir / "post-rewrite")

    if remove_commit:
        _uninstall_hook_file(hooks_dir / "post-commit")

    if getattr(args, "all", False) or getattr(args, "with_config", False):
        for key in ("notes.rewrite.rebase", "notes.rewrite.amend", "notes.rewriteRef"):
            run_git(["config", "--unset", key], repo_root=repo_root)
        for key in ("prompt-log.exclude", "prompt-note.exclude", "prompt-log.adapter"):
            run_git(["config", "--unset-all", key], repo_root=repo_root)
        print("Cleaned local git config (notes.rewrite*, prompt-log.exclude, prompt-log.adapter)")

    if getattr(args, "all", False) or getattr(args, "with_skill", False):
        for folder_name in ("git-prompt-log", "git-prompt-note", "agy-prompt-note"):
            skill_target = repo_root / ".agents" / "skills" / folder_name / "SKILL.md"
            if skill_target.exists():
                skill_target.unlink()
                print(f"Removed local skill {skill_target.relative_to(repo_root)}")
                parent = skill_target.parent
                while parent != repo_root:
                    try:
                        if not any(parent.iterdir()):
                            parent.rmdir()
                            parent = parent.parent
                        else:
                            break
                    except Exception:
                        break

    return 0


def cmd_edit(args: argparse.Namespace) -> int:
    """Opens git notes in $EDITOR for manual editing."""
    repo_root = get_repo_root()
    commit_target = getattr(args, "commit", "HEAD") or "HEAD"
    code, commit_out, err = run_git(["rev-parse", commit_target], repo_root=repo_root)
    if code != 0:
        sys.stderr.write(f"Error resolving commit '{commit_target}': {err}\n")
        return 1
    commit_hash = commit_out
    res = subprocess.run(["git", "notes", f"--ref={args.ref}", "edit", commit_hash], cwd=repo_root)
    return res.returncode


def main():
    base_parser = argparse.ArgumentParser(add_help=False)
    base_parser.add_argument(
        "--ref",
        default=DEFAULT_NOTES_REF,
        help=f"Git notes reference namespace (default: {DEFAULT_NOTES_REF})",
    )
    base_parser.add_argument(
        "--no-pager",
        dest="no_pager",
        action="store_true",
        help="Do not pipe output into a pager",
    )
    base_parser.add_argument(
        "--color",
        choices=["always", "never", "auto"],
        default="auto",
        help="Control colored output (always, never, auto)",
    )

    parser = argparse.ArgumentParser(
        description="Records and merges AI steering prompts and session provenance in Git notes.",
        parents=[base_parser],
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # init
    p_init = subparsers.add_parser(
        "init",
        help="Initialize git-prompt-log in current repository (hooks, config)",
        parents=[base_parser],
    )
    p_init.add_argument(
        "--skill",
        dest="with_skill",
        action="store_true",
        default=False,
        help="Install local repository assistant skill at .agents/skills/git-prompt-log/SKILL.md",
    )
    p_init.add_argument(
        "--no-skill",
        dest="with_skill",
        action="store_false",
        help="Do not install local repository assistant skill (default)",
    )
    p_init.add_argument(
        "--adapter",
        "-a",
        choices=["antigravity", "claude", "manual", "auto"],
        default=None,
        help="Explicitly configure default assistant harness / adapter",
    )
    p_init.add_argument(
        "--no-post-commit",
        dest="with_post_commit",
        action="store_false",
        default=True,
        help="Skip installing post-commit hook for automated agent prompt recording",
    )

    # record
    p_record = subparsers.add_parser("record", help="Attach prompt note to a commit", parents=[base_parser])
    p_record.add_argument("--commit", "-c", help="Target commit hash or ref (default: HEAD)")
    p_record.add_argument("--session", "-s", help="Explicit session conversation ID UUID")
    p_record.add_argument(
        "--adapter",
        "-a",
        choices=["auto", "antigravity", "claude", "manual", "direct"],
        default="auto",
        help="Ingestion adapter (auto, antigravity, claude, manual)",
    )
    p_record.add_argument("--message", "-m", help="Manually record prompt text without transcript")
    p_record.add_argument("--stdin", action="store_true", help="Read manual prompt text from standard input")
    p_record.add_argument("--harness", help="Override harness name string in note")
    p_record.add_argument("--model", help="Override model name string in note")
    p_record.add_argument("--exclude", "--drop", help="Exclude prompts matching regex pattern")
    p_record.add_argument("--drop-last", type=int, default=0, help="Exclude last N prompts")
    p_record.add_argument("--edit", "-e", action="store_true", help="Edit note in $EDITOR before saving")
    p_record.add_argument("--quiet", "-q", action="store_true", help="Suppress confirmation message")
    p_record.add_argument("--dry-run", "-n", action="store_true", help="Print note without writing to git")

    # adapters
    p_adapters = subparsers.add_parser(
        "adapters", help="List supported and active AI ingestion adapters", parents=[base_parser]
    )
    p_adapters.add_argument("--json", action="store_true", help="Output adapter information as JSON")

    # harness / adapter
    p_harness = subparsers.add_parser(
        "harness",
        aliases=["adapter"],
        help="Get or set configured assistant harness (antigravity, claude, manual)",
        parents=[base_parser],
    )
    p_harness.add_argument(
        "name",
        nargs="?",
        choices=["antigravity", "claude", "manual", "auto", "none", "clear"],
        help="Harness name to set (or 'clear' to restore auto-detection)",
    )
    p_harness.add_argument(
        "--global",
        dest="global_config",
        action="store_true",
        help="Configure harness globally across all repositories",
    )

    # post-commit
    p_post_commit = subparsers.add_parser(
        "post-commit", help="Triggered by git post-commit hook for agent recording", parents=[base_parser]
    )

    # post-rewrite
    p_rewrite = subparsers.add_parser(
        "post-rewrite", help="Handle git post-rewrite hook (stdin: <old> <new>)", parents=[base_parser]
    )
    p_rewrite.add_argument("--verbose", "-v", action="store_true", help="Print status messages")

    # show
    p_show = subparsers.add_parser("show", help="Display prompt note on a commit", parents=[base_parser])
    p_show.add_argument("commit", nargs="?", default="HEAD", help="Target commit hash or ref")
    p_show.add_argument("--active", "-a", action="store_true", help="Display only the active steering prompt")
    p_show.add_argument("--incremental", "-i", action="store_true", help="Display only incremental prompts since parent commit")

    # log
    p_log = subparsers.add_parser("log", help="Display commits with their steering prompts", parents=[base_parser])
    p_log.add_argument("range", nargs="?", help="Commit range (default: detected branch range)")
    p_log.add_argument("-n", "--max-count", type=int, dest="max_count", help="Limit number of commits to display")
    p_log.add_argument("--full", action="store_true", help="Display full cumulative prompts instead of active prompt")

    # edit
    p_edit = subparsers.add_parser("edit", help="Edit prompt note on a commit in $EDITOR", parents=[base_parser])
    p_edit.add_argument("commit", nargs="?", default="HEAD", help="Target commit hash or ref (default: HEAD)")

    # install / install-hook
    p_install = subparsers.add_parser(
        "install",
        aliases=["install-hook", "install-hooks"],
        help="Install git-prompt-log in current repository (hooks, config)",
        parents=[base_parser],
    )
    p_install.add_argument(
        "--skill",
        dest="with_skill",
        action="store_true",
        default=False,
        help="Install local repository assistant skill at .agents/skills/git-prompt-log/SKILL.md",
    )
    p_install.add_argument(
        "--no-skill",
        dest="with_skill",
        action="store_false",
        help="Do not install local repository assistant skill (default)",
    )
    p_install.add_argument(
        "--adapter",
        "-a",
        choices=["antigravity", "claude", "manual", "auto"],
        default=None,
        help="Explicitly configure default assistant harness / adapter",
    )
    p_install.add_argument(
        "--no-post-commit",
        dest="with_post_commit",
        action="store_false",
        default=True,
        help="Skip installing post-commit hook for automated agent prompt recording",
    )

    # uninstall-hook
    p_uninstall = subparsers.add_parser(
        "uninstall-hook",
        aliases=["uninstall", "uninstall-hooks"],
        help="Uninstall git-prompt-log hooks (and optionally config/skill)",
        parents=[base_parser],
    )
    p_uninstall.add_argument("--all", action="store_true", help="Remove hooks, clean git config, and remove skill")
    p_uninstall.add_argument("--config", dest="with_config", action="store_true", help="Also unset git notes rewrite configs")
    p_uninstall.add_argument("--skill", dest="with_skill", action="store_true", help="Also remove local .agents skill")
    p_uninstall.add_argument("--post-commit-only", action="store_true", help="Only uninstall post-commit hook")
    p_uninstall.add_argument("--post-rewrite-only", action="store_true", help="Only uninstall post-rewrite hook")

    # export-log
    p_export = subparsers.add_parser(
        "export-log", help="Export prompt notes across branch commits to a markdown log", parents=[base_parser]
    )
    p_export.add_argument("--range", "-r", help="Commit range (default: detected branch range, e.g. main..HEAD)")
    p_export.add_argument("--output", "-o", help="Target output filepath (default: prompts/YYYY_MM_DD_HHMMSS_<slug>.md)")
    p_export.add_argument("--slug", help="Custom slug name for the exported log")
    p_export.add_argument("--commit", action="store_true", help="Stage and commit the exported markdown log file")
    p_export.add_argument("--stdout", action="store_true", help="Print log to stdout instead of writing to a file")

    # import-log
    p_import = subparsers.add_parser(
        "import-log", help="Import prompt notes from an exported markdown log file into git notes", parents=[base_parser]
    )
    p_import.add_argument("file", help="Path to exported prompt log markdown file")
    p_import.add_argument("--commit", "-c", help="Attach to a specific target commit instead of resolving from log")

    # session
    p_session = subparsers.add_parser(
        "session", help="Inspect and manage prompt exclusions for a specific agent session", parents=[base_parser]
    )
    p_session.add_argument(
        "action",
        nargs="?",
        default="list",
        choices=["list", "show", "drop", "exclude", "undrop", "restore", "clear"],
        help="Action: list (default), drop, undrop, clear",
    )
    p_session.add_argument("target", nargs="?", help="Prompt 1-based index (e.g. 2) or regex pattern (e.g. 'Commit')")
    p_session.add_argument("--session", "-s", help="Target session conversation UUID (default: active session)")
    p_session.add_argument("--commit", "-c", default="HEAD", help="Commit to update note on (default: HEAD)")
    p_session.add_argument("--no-update", action="store_true", help="Do not automatically re-record note on commit")

    args = parser.parse_args()

    if args.command in ("init", "install", "install-hook", "install-hooks"):
        sys.exit(cmd_install_hook(args))
    elif args.command in ("uninstall-hook", "uninstall", "uninstall-hooks"):
        sys.exit(cmd_uninstall_hook(args))
    elif args.command == "record":
        sys.exit(cmd_record(args))
    elif args.command == "adapters":
        sys.exit(cmd_adapters(args))
    elif args.command in ("harness", "adapter"):
        sys.exit(cmd_harness(args))
    elif args.command == "session":
        sys.exit(cmd_session(args))
    elif args.command == "edit":
        sys.exit(cmd_edit(args))
    elif args.command == "post-commit":
        sys.exit(cmd_post_commit(args))
    elif args.command == "post-rewrite":
        sys.exit(cmd_post_rewrite(args))
    elif args.command == "show":
        sys.exit(cmd_show(args))
    elif args.command == "log":
        sys.exit(cmd_log(args))
    elif args.command == "export-log":
        sys.exit(cmd_export_log(args))
    elif args.command == "import-log":
        sys.exit(cmd_import_log(args))
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
